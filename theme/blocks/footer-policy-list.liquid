
{% if shop.policies.size > 0 %}
  <nav
    class="
      footer-utilities__policy-list
      custom-typography
      {% if block.settings.font_size != "" %}custom-font-size{% endif %}
    "
    aria-label="Store policies"
    style="{% render 'typography-style', preset: 'custom', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <ul class="policy-list policy-list--inline list-unstyled">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li class="policy-list__item">
            <a
              href="{{ policy.url }}"
              class="footer-utilities__text policy-list__link"
            >
              {{- policy.title | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .policy-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
  }

  .policy-list__link {
    display: inline-block;
    text-decoration: none;
  }

  .policy-list__link:hover,
  .policy-list__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 750px) {
    .policy-list {
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    .policy-list {
      row-gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
