# Dashboard env vars.
# Local: cp to .env.local
# Production (Cloudflare Pages): set these in the Pages dashboard → Settings → Environment Variables.

# Supabase — same project as the worker uses. Get from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Used for privileged DB ops (kill switch, etc.).
# NEVER expose to the browser. Next.js automatically keeps non-NEXT_PUBLIC_ vars server-side.
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed to log in to the dashboard.
NEXT_PUBLIC_ALLOWED_EMAIL=
