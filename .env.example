# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# === Anthropic (the only thing that costs money) ===
ANTHROPIC_API_KEY=

# === Supabase (free tier — database + auth) ===
# Create a project at https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Shopify Admin API ===
# Shopify Admin → Apps → Develop apps → create custom app → Admin API access token
SHOPIFY_STORE_DOMAIN=houseofyeashi.myshopify.com
SHOPIFY_ADMIN_API_KEY=

# === Gmail (already wired via MCP — these are for direct API use if needed) ===
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# === Instagram Graph API (Phase 3 — needs Meta App Review) ===
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# === Razorpay (Phase 2 — post-KYC, read-only for Finance agent) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# === Operator contact ===
# Vanshika's email — where alerts and approval batches go
OPERATOR_EMAIL=

# === Cost & rate limits ===
DAILY_INR_BUDGET=200
PAUSE_ALL=false
