{
  "name": "hoy-sm-ai",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-agent ops system for House of Yeashi (HOY) — see README.md",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "hoy": "npm run hoy --workspace=@hoy/cli --",
    "worker:execute-pending": "npm run execute-pending --workspace=@hoy/worker",
    "worker:standup": "npm run standup --workspace=@hoy/worker",
    "dashboard:dev": "npm run dev --workspace=@hoy/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
