{%- liquid
  assign jar_link = section.settings.jar_link
  if jar_link == blank
    assign jar_link = '/products/mystery-jars?variant=54984435990850&view=default'
  endif
-%}

<div class="hoy-jar-highlight color-{{ section.settings.color_scheme }}">
  <div class="hoy-jar-highlight__inner page-width">
    <div class="hoy-jar-highlight__layout">
      <div class="hoy-jar-highlight__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="hoy-jar-highlight__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hoy-jar-highlight__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <a class="hoy-jar-highlight__media" href="{{ jar_link }}">
        <img
          class="hoy-jar-highlight__img"
          src="{{ 'hoy-mystery-jars-guide.jpeg' | asset_url }}"
          alt="Mystery Jars options and prices"
          width="1536"
          height="1024"
          loading="lazy"
        >
      </a>

      <div class="hoy-jar-highlight__actions">
        <a class="button hoy-jar-highlight__button" href="{{ jar_link }}">
          {{ section.settings.cta_label }}
        </a>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hoy-jar-highlight {
    padding-block: 56px;
  }

  .hoy-jar-highlight__layout {
    display: grid;
    gap: 24px;
    justify-items: center;
  }

  .hoy-jar-highlight__media {
    display: block;
    width: min(100%, 1120px);
    overflow: hidden;
    border-radius: 8px;
    background: #f7f3ef;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hoy-jar-highlight__media:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 42px rgb(var(--color-foreground-rgb) / 0.12);
  }

  .hoy-jar-highlight__img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  .hoy-jar-highlight__content {
    text-align: center;
  }

  .hoy-jar-highlight__title {
    margin: 0 0 10px;
    font-size: 2.2rem;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hoy-jar-highlight__subtitle {
    margin: 0 auto;
    max-width: 46ch;
    opacity: 0.75;
  }

  .hoy-jar-highlight__actions {
    display: flex;
    justify-content: center;
  }

  .hoy-jar-highlight__button {
    width: fit-content;
  }

  @media screen and (max-width: 749px) {
    .hoy-jar-highlight {
      padding-block: 32px;
    }

    .hoy-jar-highlight__layout {
      gap: 18px;
    }

    .hoy-jar-highlight__title {
      font-size: 1.7rem;
    }

    .hoy-jar-highlight__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Jewellery Jar Highlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mystery Jewellery Jar"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your surprise jar - free shipping on every jar."
    },
    {
      "type": "url",
      "id": "jar_link",
      "label": "Mystery jar link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Choose Your Jar"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Jewellery Jar Highlight"
    }
  ]
}
{% endschema %}
